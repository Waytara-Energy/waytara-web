{
  "name": "@waytara/supabase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client-browser.ts",
    "./server": "./src/client-server.ts",
    "./middleware": "./src/middleware.ts",
    "./auth": "./src/auth.ts",
    "./roles": "./src/roles.ts",
    "./service-role": "./src/service-role.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "db:types": "node scripts/generate-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:local": "node scripts/local-db.mjs up",
    "db:local:reset": "node scripts/local-db.mjs reset",
    "test:db": "node scripts/test-db.mjs"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "next": "16.3.8",
    "react": "19.3.0",
    "supabase": "^2.119.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
