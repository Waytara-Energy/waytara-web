# Env vars required by apps/web. Copy to apps/web/.env.local and fill in real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Not a runtime var — only used locally to run `pnpm db:types`
# (packages/supabase). Set it in your shell, don't put it in .env.local.
# SUPABASE_PROJECT_ID=
