# Env vars required by apps/web and apps/admin. Copy to apps/<app>/.env.local
# and fill in real values. NEXT_PUBLIC_SITE_URL and CUSTOMER_APP_URL differ
# per app (see below) — don't just copy one app's file into the other's.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# This app's own public URL. apps/web uses it as the general site origin;
# apps/admin also uses it specifically to build staff invite links
# ({NEXT_PUBLIC_SITE_URL}/invite/{token}, see
# apps/admin/src/lib/send-employee-invite-email.ts).
NEXT_PUBLIC_SITE_URL=

# Server-only — NEVER prefix this with NEXT_PUBLIC_. Bypasses RLS entirely;
# used by @waytara/supabase/service-role for: invite-token verification and
# account provisioning during signup (both apps), and apps/web's
# /api/cron/detect-alerts Task 12.1 job, which has no signed-in session to
# scope RLS against (see packages/supabase/src/service-role.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Resend — used by every transactional sender in both apps:
#   apps/web:   lead-notification email to the team (lib/notify-team.ts)
#   apps/admin: quotation PDF email (lib/send-quotation-email.ts),
#               customer account-setup invite (lib/send-customer-invite-email.ts),
#               staff invite (lib/send-employee-invite-email.ts),
#               "your system is live" install-complete email
#               (lib/send-install-complete-email.ts)
# Without RESEND_API_KEY set, the underlying action (lead save, quotation
# send, invite, etc.) still completes — the email is just skipped, logged
# as a warning. RESEND_FROM_EMAIL defaults to
# "WayTara Energy <onboarding@resend.dev>" (Resend's sandbox sender) if unset.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# apps/web only — where team-notification emails for new leads go
# (lib/notify-team.ts).
LEADS_NOTIFICATION_EMAIL=hello@waytaraenergy.com

# apps/admin only — where customer-facing emails point the customer back to
# apps/web: {CUSTOMER_APP_URL}/invite/{token} (account setup, once payment
# is recorded) and {CUSTOMER_APP_URL}/dashboard (install-complete "you're
# live" email). Production should be apps/web's real deployed URL.
CUSTOMER_APP_URL=http://localhost:3000

# apps/web only — shared secret for the /api/cron/* routes. REQUIRED in
# production: with no secret the routes refuse every request (they use the
# service-role key). Supabase pg_cron calls them with
# `Authorization: Bearer <CRON_SECRET>`; the same value must be stored in
# Supabase Vault as `cron_secret` (see docs/OPERATIONS.md). Generate with
# `openssl rand -hex 32`. Outside production an unset value is tolerated.
CRON_SECRET=

# Not a runtime var — only used locally to run `pnpm db:types`
# (packages/supabase). Set it in your shell, don't put it in .env.local.
# SUPABASE_PROJECT_ID=

# Canonical public origin used in canonical URLs, sitemap and structured data.
# Optional — defaults to https://www.waytaraenergy.com (apps/web). Do NOT point it
# at localhost.
# NEXT_PUBLIC_CANONICAL_URL=https://www.waytaraenergy.com

# Error monitoring (Sentry). Both optional; everything stays off when unset.
# SENTRY_DSN is for server code, NEXT_PUBLIC_SENTRY_DSN for the browser; they
# can hold the same DSN. Setting the public one also extends the CSP
# connect-src to that DSN's origin.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
