# Env vars required by apps/web and apps/admin. Copy to apps/<app>/.env.local
# and fill in real values (NEXT_PUBLIC_SITE_URL differs per app — each app's
# own URL, not shared).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only — NEVER prefix this with NEXT_PUBLIC_. Bypasses RLS entirely;
# used only by @waytara/supabase/service-role for invite-token verification
# and account provisioning during signup (see packages/supabase/src/service-role.ts).
SUPABASE_SERVICE_ROLE_KEY=

# apps/web only — team notification email when a new lead comes in via the
# quote-request form (see apps/web/src/lib/notify-team.ts). Without
# RESEND_API_KEY set, the lead is still saved; the email is just skipped.
RESEND_API_KEY=
LEADS_NOTIFICATION_EMAIL=contactus@waytaraenergy.com
RESEND_FROM_EMAIL=

# Not a runtime var — only used locally to run `pnpm db:types`
# (packages/supabase). Set it in your shell, don't put it in .env.local.
# SUPABASE_PROJECT_ID=
